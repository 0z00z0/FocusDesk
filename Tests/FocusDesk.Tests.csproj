<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Targets the same Windows-specific TFM as FocusDesk.csproj (required for a ProjectReference to a
    net10.0-windows project). Deliberately does NOT set UseWinUI/WindowsPackageType/etc. — the types
    under test are plain C# with no XAML or WinRT dependency, so the test project stays lightweight.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>FocusDesk.Tests</RootNamespace>

    <!-- Pin the output paths relative to THIS project. Without this, a build of both projects
         together leaks FocusDesk.csproj's RID-specific "win-x64" output path into this project's
         copy targets, producing a malformed nested bin\...\Tests\bin\...\Tests\bin\... path and
         failing to find WinUI asset files that were never meant to be copied here. -->
    <BaseOutputPath>bin\</BaseOutputPath>
    <BaseIntermediateOutputPath>obj\</BaseIntermediateOutputPath>
    <RuntimeIdentifier></RuntimeIdentifier>
  </PropertyGroup>

  <!-- Versions come from Directory.Packages.props; all three are family pins. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FocusDesk.csproj" />
  </ItemGroup>

</Project>
