<?xml version="1.0" encoding="utf-8"?>
<root>
  <resheader name="resmimetype">
    <value>text/microsoft-resx</value>
  </resheader>
  <resheader name="version">
    <value>2.0</value>
  </resheader>
  <resheader name="reader">
    <value>System.Resources.ResXResourceReader, System.Windows.Forms, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089</value>
  </resheader>
  <resheader name="writer">
    <value>System.Resources.ResXResourceWriter, System.Windows.Forms, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089</value>
  </resheader>

  <!-- Focus page: the kind of session and the heading over each kind's own settings. -->
  <data name="FocusKindCardHeader" xml:space="preserve">
    <value>Kind of session</value>
    <comment>Header of the card choosing the kind on the Focus page, noun phrase.</comment>
  </data>
  <data name="FocusKindCardDescription" xml:space="preserve">
    <value>What a session started from Home Assistant does. The status window offers both.</value>
    <comment>Description under the kind card, whole sentences; the status window is the tray pop-out.</comment>
  </data>
  <data name="FocusKindProgramFocusOption" xml:space="preserve">
    <value>Program focus</value>
    <comment>Radio button choosing program focus on the kind card, glossary term, capitalised.</comment>
  </data>
  <data name="FocusKindScreenBreakOption" xml:space="preserve">
    <value>Screen break</value>
    <comment>Radio button choosing screen break on the kind card, glossary term, capitalised.</comment>
  </data>
  <data name="FocusProgramFocusHeading" xml:space="preserve">
    <value>Program focus</value>
    <comment>Section heading over the program list on the Focus page, glossary term, capitalised.</comment>
  </data>
  <data name="FocusScreenBreakHeading" xml:space="preserve">
    <value>Screen break</value>
    <comment>Section heading over the dim and input switches on the Focus page, glossary term, capitalised.</comment>
  </data>

  <!-- Focus page: the Programs section. -->
  <data name="FocusProgramsHeader" xml:space="preserve">
    <value>Programs</value>
    <comment>Heading of the card above the program list, noun.</comment>
  </data>
  <data name="FocusProgramsDescription" xml:space="preserve">
    <value>What a session lets run, and what keeps the network while a session blocks it.</value>
    <comment>Description under the Programs heading, whole sentence.</comment>
  </data>
  <data name="FocusProgramsAddButton" xml:space="preserve">
    <value>Add a program</value>
    <comment>Button that opens the program picker, imperative.</comment>
  </data>
  <data name="FocusProgramCanRun" xml:space="preserve">
    <value>Can run</value>
    <comment>Checkbox on a program row: the program may be used during a session.</comment>
  </data>
  <data name="FocusProgramCanUseNetwork" xml:space="preserve">
    <value>Can use the network</value>
    <comment>Checkbox on a program row: the program keeps the network during a network block.</comment>
  </data>
  <data name="FocusProgramRemove" xml:space="preserve">
    <value>Remove</value>
    <comment>Button on a program row that takes it off the list, imperative.</comment>
  </data>
  <data name="FocusProgramNotFound" xml:space="preserve">
    <value>Not found on this machine</value>
    <comment>Status shown under a row whose program is not installed here; the list roams between machines.</comment>
  </data>
  <data name="FocusProgramStoreNetworkInfo" xml:space="preserve">
    <value>A firewall rule cannot name a Store app yet.</value>
    <comment>Hover text on the disabled network checkbox of a Store app row, whole sentence.</comment>
  </data>
  <data name="FocusProgramWebAppNetworkInfo" xml:space="preserve">
    <value>Set by the browser's own row.</value>
    <comment>Hover text on the disabled network checkbox of a web app row, whole sentence.</comment>
  </data>
  <data name="FocusProgramWindowsRunInfo" xml:space="preserve">
    <value>Part of Windows — always usable.</value>
    <comment>Hover text on the ticked, disabled run checkbox of a Windows program row, whole sentence.</comment>
  </data>
  <data name="FocusProgramsRefusalSessionRunning" xml:space="preserve">
    <value>The list cannot change while a session is running.</value>
    <comment>Why a change to the program list was refused, whole sentence.</comment>
  </data>
  <data name="FocusProgramsRefusalNotAProgram" xml:space="preserve">
    <value>That is not a program the list can name.</value>
    <comment>Why a change to the program list was refused, whole sentence.</comment>
  </data>
  <data name="FocusProgramsRefusalListFull" xml:space="preserve">
    <value>The list already holds {0} programs, which is as many as it takes.</value>
    <comment>Why a program was not added; {0} is the maximum number of programs, always plural.</comment>
  </data>
  <data name="FocusProgramsRefusalAlreadyAllowed" xml:space="preserve">
    <value>That program is already on the list.</value>
    <comment>Why a program was not added, whole sentence.</comment>
  </data>
  <data name="FocusProgramsRefusalNotAllowed" xml:space="preserve">
    <value>That program was not on the list.</value>
    <comment>Why a change to a row was refused, whole sentence.</comment>
  </data>
  <data name="FocusProgramsRefusalNotOffered" xml:space="preserve">
    <value>That choice does nothing for this kind of program.</value>
    <comment>Why a checkbox change was refused, whole sentence.</comment>
  </data>

  <!-- The program picker window. -->
  <data name="PickerTitle" xml:space="preserve">
    <value>Add a program</value>
    <comment>Title of the program picker window and its heading, imperative.</comment>
  </data>
  <data name="PickerSearchPlaceholder" xml:space="preserve">
    <value>Type to narrow the list</value>
    <comment>Placeholder in the picker's search box, imperative.</comment>
  </data>
  <data name="PickerSearchName" xml:space="preserve">
    <value>Search programs</value>
    <comment>Screen-reader name of the picker's search box.</comment>
  </data>
  <data name="PickerListName" xml:space="preserve">
    <value>Programs</value>
    <comment>Screen-reader name of the picker's list, noun.</comment>
  </data>
  <data name="PickerLoading" xml:space="preserve">
    <value>Reading the Start menu…</value>
    <comment>Shown while the picker reads the Start menu, status phrase.</comment>
  </data>
  <data name="PickerNothingFound" xml:space="preserve">
    <value>Nothing was found in the Start menu.</value>
    <comment>Shown when the Start menu yields no program at all, whole sentence.</comment>
  </data>
  <data name="PickerNothingMatches" xml:space="preserve">
    <value>Nothing matches.</value>
    <comment>Shown when the typed words match no program, whole sentence.</comment>
  </data>
  <data name="PickerNote" xml:space="preserve">
    <value>Add every program the session needs — a password manager, a remote-desktop client, an accessibility tool.</value>
    <comment>Advice line at the foot of the picker, whole sentence.</comment>
  </data>
  <data name="PickerOpenMark" xml:space="preserve">
    <value>open</value>
    <comment>Marks a row whose program is running now, adjective, lower case.</comment>
  </data>
  <data name="PickerCancel" xml:space="preserve">
    <value>Cancel</value>
    <comment>Button that closes the picker without adding, imperative.</comment>
  </data>
  <data name="PickerAdd" xml:space="preserve">
    <value>Add</value>
    <comment>Button that adds the selected program, imperative.</comment>
  </data>

  <!-- The one session description the tray menu, the hover text, the status window and the Focus
       page share: a template per stage, led by the kind, with the held levers as a joined list. -->
  <data name="FocusDescribeActive" xml:space="preserve">
    <value>{0}: {1} min left — {2}</value>
    <comment>Session line while running; {0} kind name, {1} whole minutes left (plural), {2} comma-joined levers held.</comment>
  </data>
  <data name="FocusDescribeEnding" xml:space="preserve">
    <value>{0}: {1} min left — {2}, cancel asked for</value>
    <comment>Session line during the cancel wait; placeholders as in FocusDescribeActive.</comment>
  </data>
  <data name="FocusDescribeConfirm" xml:space="preserve">
    <value>{0}: {1} min left — {2}, waiting for the second request</value>
    <comment>Session line while the cancel can be confirmed from Home Assistant; placeholders as in FocusDescribeActive.</comment>
  </data>
  <data name="FocusDescribeNotRunning" xml:space="preserve">
    <value>No focus session is running.</value>
    <comment>Session line when nothing runs, whole sentence.</comment>
  </data>
  <data name="FocusKindProgramFocus" xml:space="preserve">
    <value>Program focus</value>
    <comment>Kind name leading the session line, glossary term, capitalised.</comment>
  </data>
  <data name="FocusKindScreenBreak" xml:space="preserve">
    <value>Screen break</value>
    <comment>Kind name leading the session line, glossary term, capitalised.</comment>
  </data>
  <data name="FocusDetailScreenCovered" xml:space="preserve">
    <value>screen covered</value>
    <comment>One item in the comma-joined list of what a running session holds, lower case, no full stop.</comment>
  </data>
  <data name="FocusDetailInputBlocked" xml:space="preserve">
    <value>mouse and keyboard blocked</value>
    <comment>One item in the comma-joined list of what a running session holds, lower case, no full stop.</comment>
  </data>
  <data name="FocusDetailScreenDimmed" xml:space="preserve">
    <value>screen dimmed</value>
    <comment>One item in the comma-joined list of what a running session holds, lower case, no full stop.</comment>
  </data>
  <data name="FocusDetailNetworkBlocked" xml:space="preserve">
    <value>network blocked</value>
    <comment>One item in the comma-joined list of what a running session holds, lower case, no full stop.</comment>
  </data>
  <data name="FocusDetailNothingHeld" xml:space="preserve">
    <value>nothing held</value>
    <comment>Stands in for the list when a running session has lost every lever, lower case, no full stop.</comment>
  </data>

  <!-- The focus-app lever: what each surface says while it holds. -->
  <data name="FocusDetailProgramsLimited" xml:space="preserve">
    <value>programs limited</value>
    <comment>One item in the comma-joined list of what a running session holds, lower case, no full stop.</comment>
  </data>
  <data name="PopOutProgramsLimited" xml:space="preserve">
    <value>Only the chosen programs can be used until the session ends.</value>
    <comment>Line on the tray pop-out while the lever holds, whole sentence.</comment>
  </data>
  <data name="PopOutFocusPointShow" xml:space="preserve">
    <value>Focus point</value>
    <comment>Label of the tray pop-out's header button that shows the session-start focus point, noun phrase.</comment>
  </data>
  <data name="PopOutFocusPointSkip" xml:space="preserve">
    <value>Skip to countdown</value>
    <comment>Label of the button under the focus point on the tray pop-out that returns to the countdown, imperative phrase.</comment>
  </data>
  <data name="PopOutStartProgramFocus" xml:space="preserve">
    <value>Program focus</value>
    <comment>Button on the tray pop-out that chooses program focus as the kind Start arms, glossary term, capitalised.</comment>
  </data>
  <data name="PopOutStartScreenBreak" xml:space="preserve">
    <value>Screen break</value>
    <comment>Button on the tray pop-out that chooses a screen break as the kind Start arms, glossary term, capitalised.</comment>
  </data>
  <data name="PopOutStart" xml:space="preserve">
    <value>Start</value>
    <comment>Button on the tray pop-out that starts a session of the chosen kind, imperative verb.</comment>
  </data>
  <data name="PopOutStartProgramFocusInfo" xml:space="preserve">
    <value>Tick at least one program as Can run on the Focus page</value>
    <comment>Hover text on the disabled program-focus button, imperative; Can run names the checkbox; no full stop.</comment>
  </data>
  <data name="PopOutRefusalAlreadyRunning" xml:space="preserve">
    <value>A session is already running.</value>
    <comment>Line under the start buttons when a start is refused because one runs, whole sentence.</comment>
  </data>
  <data name="PopOutRefusalLeverRefused" xml:space="preserve">
    <value>The session could not take what its kind needs: a display to cover, a program ticked Can run, or a brightness to dim.</value>
    <comment>Line under the start buttons when the kind's own lever or the dim refuses, whole sentence.</comment>
  </data>
  <data name="PopOutRefusalLeverFailed" xml:space="preserve">
    <value>Something the session needed failed to engage. Whatever did engage has been lifted again.</value>
    <comment>Line under the start buttons when a lever failed after agreeing, whole sentences.</comment>
  </data>
  <data name="CoverProgramsLimited" xml:space="preserve">
    <value>only the chosen programs can be used</value>
    <comment>One clause in the cover's list of what the session holds, lower case, no full stop.</comment>
  </data>
  <data name="CoverMinutesLeft" xml:space="preserve">
    <value>MIN LEFT</value>
    <comment>Unit under the cover's countdown figure while whole minutes are counted, capitals, plural.</comment>
  </data>
  <data name="CoverSecondsLeft" xml:space="preserve">
    <value>SEC LEFT</value>
    <comment>Unit under the cover's countdown figure in the last minute, seconds, capitals, plural.</comment>
  </data>
  <data name="CoverFocusPointHint" xml:space="preserve">
    <value>Keep the eyes on the point · blinking is fine</value>
    <comment>Quiet line under the breathing point on the focus-point cover, no full stop.</comment>
  </data>
  <data name="CoverFocusPointDone" xml:space="preserve">
    <value>Done — back to work</value>
    <comment>Line on the focus-point cover when the countdown reaches its end, no full stop.</comment>
  </data>
  <data name="UnattendedUpdatesHeader" xml:space="preserve">
    <value>Install updates by themselves</value>
    <comment>Header of the switch on the About page, imperative phrase.</comment>
  </data>
  <data name="UnattendedUpdatesDescription" xml:space="preserve">
    <value>Checks once a day and installs while the screen is locked or nothing has been touched for 10 minutes.</value>
    <comment>Description under the switch on the About page, whole sentence.</comment>
  </data>
  <data name="UnattendedUpdatesSubject" xml:space="preserve">
    <value>installing updates by themselves</value>
    <comment>Screen-reader subject of the info bubble beside the switch, noun phrase, lower case.</comment>
  </data>
  <data name="UnattendedUpdatesInfo" xml:space="preserve">
    <value>Never during a focus session. FocusDesk closes for the install and starts again afterwards.</value>
    <comment>Hover text of the info bubble beside the switch, whole sentences.</comment>
  </data>
</root>
