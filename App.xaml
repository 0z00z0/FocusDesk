<?xml version="1.0" encoding="utf-8" ?>
<Application
    x:Class="FocusDesk.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:primitives="using:Microsoft.UI.Xaml.Controls.Primitives"
    xmlns:zz="using:ZeroZero.Controls.WinUI">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <!-- The studio palette and typeface. Every colour FocusDesk shows resolves out of
                     this dictionary; no hex literal appears in this file. -->
                <ResourceDictionary Source="ms-appx:///ZeroZero.Brand.WinUI/Themes/BrandResources.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- No RequestedTheme on the Application: FocusDesk follows the system light/dark
                 setting. The brand palette carries the same values in both themes, so nothing below
                 needs a pair.

                 The accent keys themselves are not here. A brush declared at this level cannot take
                 its colour from a key that lives inside a merged dictionary's theme dictionaries,
                 and a theme dictionary of this file's own would not override a stock WinUI key at
                 all — a key one level deeper than an immediate child is not reached. Helpers\
                 AppPalette.cs fills them from the brand constants instead, before any window is
                 built. A Setter value below is different: it resolves against the element it is
                 applied to, which is why the styles can name a brand key directly. -->

            <!-- Every TextBlock without an explicit Style takes the brand face. Keyed styles repeat
                 the setter, since a keyed style opts out of this one. -->
            <Style TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource BrandFontFamily}"/>
            </Style>

            <!-- The shared section header draws its own rule, size and weight and takes its face and
                 colour from here, so every Settings page's groups are headed alike. Purple, the page
                 title's colour: the header is a level below it by size and weight. -->
            <Style TargetType="zz:SettingsSectionHeader">
                <Setter Property="FontFamily" Value="{StaticResource BrandFontFamily}"/>
                <Setter Property="Foreground" Value="{ThemeResource BrandPurpleBrush}"/>
            </Style>

            <!-- The heading a Settings page opens with, one level above the shared
                 SettingsSectionHeader that breaks a page into groups. Purple, not the amber accent:
                 amber marks the thing that is running, and a heading in it would compete with the
                 one reading on the surface that means "right now". -->
            <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource BrandFontFamily}"/>
                <Setter Property="FontSize" Value="19"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="CharacterSpacing" Value="40"/>
                <Setter Property="Foreground" Value="{ThemeResource BrandPurpleBrush}"/>
                <Setter Property="Margin" Value="0,0,0,12"/>
            </Style>

            <!-- The small square chip shared by every row of quick buttons the pop-out and the pages
                 build. TargetType is ButtonBase rather than Button so a ToggleButton chip, which is
                 how a row shows which value is in force, takes the same chrome from this one
                 declaration. Selection is not here: it changes at runtime. -->
            <Style x:Key="QuickButtonStyle" TargetType="primitives:ButtonBase">
                <Setter Property="Padding" Value="0,4"/>
                <Setter Property="MinWidth" Value="36"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="CornerRadius" Value="4"/>
                <Setter Property="Background" Value="{ThemeResource ControlFillColorDefaultBrush}"/>
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="HorizontalContentAlignment" Value="Center"/>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
