<Project Sdk="Microsoft.NET.Sdk">

  <!-- The build kit's WinUI application block: output type, target framework and minimum platform,
       UseWinUI, WindowsPackageType None, EnableMsixTooling, WinUISDKReferences, the runtime
       identifier from the process architecture, and DefaultLanguage en-GB. Imported at the top so
       this project's own properties below still win. The kit's other three imports are at the
       repository root, and its version is in global.json. This project keeps its own app.manifest,
       so the kit writes none. -->
  <Import Project="ZeroZero.WinUIApp.props" Sdk="ZeroZero.Build" />

  <PropertyGroup>
    <RootNamespace>FocusDesk</RootNamespace>
    <Version>0.1.0</Version>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>

    <!-- Identity / packaging metadata -->
    <AssemblyTitle>FocusDesk</AssemblyTitle>
    <Product>FocusDesk</Product>
    <Description>A Windows tray application that holds the machine in a chosen state for a stretch of time.</Description>
    <Authors>ZeroZero Software</Authors>
    <Company>ZeroZero Software</Company>
    <Copyright>Copyright © 2026 ZeroZero Software</Copyright>
    <RepositoryUrl>https://github.com/0z00z0/FocusDesk</RepositoryUrl>
    <RepositoryType>git</RepositoryType>

    <!-- Windows x64 only: nothing here builds, tests or installs another architecture. -->
    <Platforms>x64</Platforms>

    <!-- Bundle the Windows App SDK runtime when publishing self-contained. Declared as a
         PROJECT-level property, conditioned on the self-contained publish, rather than a
         command-line -p:WindowsAppSDKSelfContained=true global in build-installer.ps1: a
         command-line global propagates into the referenced ZeroZero.Brand.WinUI class library,
         where the WindowsAppSDK targets reject it ("should not be applied to a class library").
         A project property stays local to this application and never reaches the reference. -->
    <WindowsAppSDKSelfContained Condition="'$(SelfContained)' == 'true'">true</WindowsAppSDKSelfContained>

    <!-- No ApplicationIcon: FocusDesk has no mark of its own yet, and the studio mark is never a
         product icon. -->
  </PropertyGroup>

  <!-- Exposes internal types to the unit test project, so tests can exercise them directly without
       widening the public surface. -->
  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>FocusDesk.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <!-- Excludes Tests\ (a separate project) and publish\ (this project's own publish output) from
       the default item globs, which would otherwise claim thousands of files from both. See
       docs\build-notes.md. -->
  <ItemGroup>
    <Compile Remove="Tests\**" />
    <None Remove="Tests\**" />
    <None Remove="publish\**" />
  </ItemGroup>

  <ItemGroup>
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>

  <!-- The shared library, as packages from the family feed. No version attribute anywhere: every
       version is pinned centrally in Directory.Packages.props, and a version here fails the build
       (ZZB006). ZeroZero.Mqtt.WinUI brings the MQTT discovery layer and client, the controls, the
       primitives and the Win32 layer with it; ZeroZero.Diagnostics brings the dump registration;
       ZeroZero.Config.Sections and ZeroZero.Config.Watch bring the settings store. Declaring any of
       those would resolve the same assembly twice. -->
  <ItemGroup>
    <PackageReference Include="ZeroZero.Brand.WinUI" />
    <PackageReference Include="ZeroZero.Config.Sections" />
    <PackageReference Include="ZeroZero.Config.Watch" />
    <PackageReference Include="ZeroZero.Diagnostics" />
    <PackageReference Include="ZeroZero.Lifecycle" />
    <PackageReference Include="ZeroZero.Mqtt.WinUI" />
    <PackageReference Include="ZeroZero.Tray" />
    <PackageReference Include="ZeroZero.Update" />
    <PackageReference Include="ZeroZero.Update.WinUI" />
  </ItemGroup>

  <!-- The app's own logging, not part of the shared library: NLog, version-pinned in
       Directory.Packages.props alongside the reasoning for the pin. -->
  <ItemGroup>
    <PackageReference Include="NLog" />
  </ItemGroup>

  <!-- WMI, which the display brightness is read and written through. -->
  <ItemGroup>
    <PackageReference Include="System.Management" />
  </ItemGroup>

  <ItemGroup>
    <!-- NLog auto-discovers nlog.config BESIDE THE EXE at runtime, so it must reach both the build
         output and the publish output (installer\build-installer.ps1 publishes into <repo>\publish,
         which ISCC packs with recursesubdirs). Without CopyToOutputDirectory it would stay in the
         repo, NLog would find no config, and the app's only forensic trail would go silent with no
         error. AppLog builds no fallback configuration if this ever fails — a missing or
         unparseable nlog.config means the application logs nothing at all; see Services/AppLog.cs. -->
    <Content Include="nlog.config">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!-- Authenticode-signs the Release bin\ output via scripts\sign.ps1. ContinueOnError keeps the
       build green regardless of why signing failed, not only when no certificate is present -
       build-installer.ps1's own later signing calls still catch a real failure before a release
       ships. See docs\build-notes.md. -->
  <PropertyGroup>
    <ZeroZeroSignNoTimestamp Condition="'$(GITHUB_ACTIONS)' != 'true'">true</ZeroZeroSignNoTimestamp>
  </PropertyGroup>

  <Target Name="SignOutput" AfterTargets="Build" Condition="'$(Configuration)' == 'Release'">
    <PropertyGroup>
      <_SignNoTimestampSwitch Condition="'$(ZeroZeroSignNoTimestamp)' == 'true'"> -NoTimestamp</_SignNoTimestampSwitch>
    </PropertyGroup>
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\scripts\sign.ps1&quot; -Path &quot;$(TargetDir)$(AssemblyName).exe&quot; -Signer &quot;$(ZeroZeroSigningScript)&quot;$(_SignNoTimestampSwitch)" ContinueOnError="true" />
  </Target>

  <!-- Publish properties: ReadyToRun on Release; trimming OFF (WinUI and its reflection are fragile
       to trim). -->
  <PropertyGroup>
    <PublishReadyToRun Condition="'$(Configuration)' != 'Debug'">true</PublishReadyToRun>
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>

  <!--
    `dotnet publish` for an unpackaged WinUI 3 application drops the app resource index
    ($(AssemblyName).pri) — it holds the compiled XAML resources (App.xaml dictionaries, control
    templates). Without it Microsoft.UI.Xaml.dll crashes at startup with a stowed exception
    (0xC000027B). Copy it into the publish output.
  -->
  <Target Name="CopyAppPriToPublish" AfterTargets="Publish" Condition="Exists('$(OutDir)$(AssemblyName).pri')">
    <Copy SourceFiles="$(OutDir)$(AssemblyName).pri" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true" />
  </Target>

  <!-- Removes the Windows App SDK machine-learning DLLs (about 38 MB) from the publish output;
       nothing here calls a Windows.AI API. See docs\build-notes.md. -->
  <Target Name="PrunePublishOutput" AfterTargets="Publish">
    <ItemGroup>
      <_FilesToPrune Include="$(PublishDir)onnxruntime.dll" />
      <_FilesToPrune Include="$(PublishDir)DirectML.dll" />
      <_FilesToPrune Include="$(PublishDir)onnxruntime_providers_shared.dll" />
      <_FilesToPrune Include="$(PublishDir)Microsoft.ML.OnnxRuntime.dll" />
    </ItemGroup>
    <Delete Files="@(_FilesToPrune)" Condition="Exists('%(Identity)')" />
    <Message Text="Pruned unused machine-learning files from the publish output." Importance="high" />
  </Target>
</Project>
