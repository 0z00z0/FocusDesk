<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="FocusDesk.UI.FocusSettingsPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:zz="using:ZeroZero.Controls.WinUI"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls">

    <StackPanel Spacing="4">
        <TextBlock Text="Focus" Style="{StaticResource SectionHeaderStyle}"/>

        <zz:SettingsSectionHeader Heading="The session" ShowDivider="False"/>

        <!-- Status, and nothing to press. A person at the keyboard cannot end a session: that is the
             feature's central property, not an omission to be filled in. -->
        <controls:SettingsCard Header="Status"
                               Description="A session runs for the length it was given. Nothing on this computer ends one early.">
            <TextBlock x:Name="FocusStatusValue" VerticalAlignment="Center"
                       MaxWidth="320" TextTrimming="CharacterEllipsis"/>
        </controls:SettingsCard>

        <controls:SettingsCard Header="Length"
                               Description="How long the next session runs. Changing this while one runs changes the next one only.">
            <ComboBox x:Name="FocusMinutesCombo" MinWidth="110"
                      SelectionChanged="OnFocusMinutesChanged"/>
        </controls:SettingsCard>

        <zz:SettingsSectionHeader Heading="What a session holds"/>

        <!-- One switch per lever, settable here or from Home Assistant — both write through the same
             settings value, so the two stay one. Locked for the length of a session once it starts:
             a lever turned off part-way through would leave its record parked with nothing owning
             it. The network and input blocks fail safe: where one is refused the session runs on
             without it, and while a session runs its switch shows what is actually held. -->
        <controls:SettingsCard Header="Blocks the network"
                               Description="Blocks every connection for the length of a session, except to the MQTT broker and the programs allowed below.">
            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <zz:InfoIcon Subject="the network block"
                             Info="Needs administrator rights and a broker set on the MQTT page. Where refused, the session runs without it."/>
                <ToggleSwitch x:Name="FocusBlocksNetworkToggle" OnContent="" OffContent=""
                              MinWidth="0" Toggled="OnFocusBlocksNetworkToggled"/>
            </StackPanel>
        </controls:SettingsCard>

        <!-- The one program list, one row per program beneath the button, each with "can run" and
             "can use the network". Empty is the whole of what an installation that has chosen no
             program carries. The texts come from the resource files. -->
        <controls:SettingsCard x:Name="FocusProgramsCard">
            <Button x:Name="FocusAllowProgramButton" Click="OnFocusAllowProgram"/>
        </controls:SettingsCard>
        <StackPanel x:Name="FocusAllowedProgramsPanel" Spacing="4"/>
        <TextBlock x:Name="FocusAllowRefusalText" Visibility="Collapsed"
                   TextWrapping="Wrap" FontSize="12" Margin="16,0,16,4"/>

        <controls:SettingsCard Header="Dims the screen"
                               Description="Lowers the built-in screen's brightness for the length of a session and puts it back afterwards.">
            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <zz:InfoIcon Subject="the screen dim"
                             Info="A lever cannot change while a session runs: its record would be left with nothing owning it."/>
                <ToggleSwitch x:Name="FocusDimsScreenToggle" OnContent="" OffContent=""
                              MinWidth="0" Toggled="OnFocusDimsScreenToggled"/>
            </StackPanel>
        </controls:SettingsCard>

        <controls:SettingsCard Header="Covers the screen"
                               Description="Puts a black window over every display for the length of a session.">
            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <zz:InfoIcon Subject="the screen cover"
                             Info="A lever cannot change while a session runs: its record would be left with nothing owning it."/>
                <ToggleSwitch x:Name="FocusCoversScreenToggle" OnContent="" OffContent=""
                              MinWidth="0" Toggled="OnFocusCoversScreenToggled"/>
            </StackPanel>
        </controls:SettingsCard>

        <controls:SettingsCard Header="Blocks the mouse and keyboard"
                               Description="Turns the mouse and keyboard off for the length of a session. The computer answers nothing, this application included.">
            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <zz:InfoIcon Subject="the mouse and keyboard block"
                             Info="Needs administrator rights. Where Windows refuses it, the session runs without it and this switch reads off."/>
                <ToggleSwitch x:Name="FocusBlocksInputToggle" OnContent="" OffContent=""
                              MinWidth="0" Toggled="OnFocusBlocksInputToggled"/>
            </StackPanel>
        </controls:SettingsCard>

        <controls:SettingsCard Header="Start a session from the status window"
                               Description="Adds a Start button to the status window. It starts a session; ending one still needs Home Assistant.">
            <ToggleSwitch x:Name="FocusStartFromStatusToggle" OnContent="" OffContent=""
                          MinWidth="0" Toggled="OnFocusStartFromStatusToggled"/>
        </controls:SettingsCard>

        <zz:SettingsSectionHeader Heading="If you are stuck"/>

        <!-- The published way out, in the words of whoever is sitting at the machine. The firewall
             names are quoted exactly and never translated: they are what a person searches the
             firewall console for. The group heading above names this card, so the card carries
             none of its own. -->
        <controls:SettingsCard ContentAlignment="Vertical"
                               HorizontalContentAlignment="Stretch">
            <StackPanel Spacing="6">
                <TextBlock TextWrapping="Wrap" FontSize="12"
                           Text="End it early from Home Assistant: send the request, wait five minutes, send it again within ten seconds."/>
                <TextBlock TextWrapping="Wrap" FontSize="12"
                           Text="Lift the network block by hand: in Windows Defender Firewall with Advanced Security, set Outbound connections back to Allow on every profile."/>
                <TextBlock TextWrapping="Wrap" FontSize="12"
                           Text="Then delete the rules in the group &quot;FocusDesk focus session&quot;: &quot;FocusDesk focus session: broker&quot;, its name resolution rule and one per allowed program."/>
                <TextBlock TextWrapping="Wrap" FontSize="12"
                           Text="The mouse and keyboard come back when the session ends. Ctrl+Alt+Delete still reaches Windows' own screen, to sign out or restart."/>
                <TextBlock TextWrapping="Wrap" FontSize="12"
                           Text="Turn the screen brightness back up by hand."/>
                <TextBlock TextWrapping="Wrap" FontSize="12"
                           Text="Exit FocusDesk to take the black cover down and lift the network block. The session keeps running, and both return at the next start."/>
            </StackPanel>
        </controls:SettingsCard>
    </StackPanel>
</UserControl>
