<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="FocusDesk.UI.FocusSettingsPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:zz="using:ZeroZero.Controls.WinUI"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls">

    <!-- Every text on this page is set from the resource files in the constructor. -->
    <StackPanel Spacing="4">
        <TextBlock x:Name="PageTitle" Style="{StaticResource SectionHeaderStyle}"/>

        <zz:SettingsSectionHeader x:Name="SessionHeader" ShowDivider="False"/>

        <!-- Status, and nothing to press: a person at the keyboard cannot end a session. -->
        <controls:SettingsCard x:Name="FocusStatusCard">
            <TextBlock x:Name="FocusStatusValue" VerticalAlignment="Center"
                       MaxWidth="320" TextTrimming="CharacterEllipsis"/>
        </controls:SettingsCard>

        <controls:SettingsCard x:Name="FocusLengthCard">
            <ComboBox x:Name="FocusMinutesCombo" MinWidth="110"
                      SelectionChanged="OnFocusMinutesChanged"/>
        </controls:SettingsCard>

        <!-- The kind the session switch over MQTT starts, locked and showing the running kind while
             a session runs. -->
        <controls:SettingsCard x:Name="FocusKindCard">
            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <RadioButton x:Name="FocusKindProgramFocusRadio" GroupName="FocusKind"
                             Checked="OnFocusKindChecked"/>
                <RadioButton x:Name="FocusKindScreenBreakRadio" GroupName="FocusKind"
                             Checked="OnFocusKindChecked"/>
            </StackPanel>
        </controls:SettingsCard>

        <!-- Read when Start is pressed, so a window already open keeps what it opened with. -->
        <zz:SettingsSectionHeader x:Name="FocusPointHeader"/>

        <controls:SettingsCard x:Name="FocusPointShownCard">
            <ToggleSwitch x:Name="FocusPointShownToggle" OnContent="" OffContent=""
                          MinWidth="0" Toggled="OnFocusPointShownToggled"/>
        </controls:SettingsCard>

        <controls:SettingsCard x:Name="FocusPointStartsSessionCard">
            <ToggleSwitch x:Name="FocusPointStartsSessionToggle" OnContent="" OffContent=""
                          MinWidth="0" Toggled="OnFocusPointStartsSessionToggled"/>
        </controls:SettingsCard>

        <controls:SettingsCard x:Name="FocusPointSecondsCard">
            <NumberBox x:Name="FocusPointSecondsBox" MinWidth="110"
                       SmallChange="5" LargeChange="30"
                       SpinButtonPlacementMode="Compact" ValidationMode="InvalidInputOverwritten"
                       ValueChanged="OnFocusPointSecondsChanged"/>
        </controls:SettingsCard>

        <zz:SettingsSectionHeader x:Name="AutomaticSessionHeader"/>

        <controls:SettingsCard x:Name="GuideCard">
            <Button x:Name="OpenGuideButton" Style="{StaticResource AccentButtonStyle}"
                    Click="OnOpenGuideClick"/>
        </controls:SettingsCard>

        <zz:SettingsSectionHeader x:Name="StuckHeader"/>

        <!-- The published way out. The firewall names are filled in from the rules the code writes
             and never translated: they are what a person searches the firewall console for. -->
        <controls:SettingsCard ContentAlignment="Vertical"
                               HorizontalContentAlignment="Stretch">
            <StackPanel Spacing="6">
                <TextBlock x:Name="StuckEndEarlyText" TextWrapping="Wrap" FontSize="12"/>
                <TextBlock x:Name="StuckNetworkText" TextWrapping="Wrap" FontSize="12"/>
                <TextBlock x:Name="StuckRulesText" TextWrapping="Wrap" FontSize="12"/>
                <TextBlock x:Name="StuckInputText" TextWrapping="Wrap" FontSize="12"/>
                <TextBlock x:Name="StuckBrightnessText" TextWrapping="Wrap" FontSize="12"/>
            </StackPanel>
        </controls:SettingsCard>
    </StackPanel>
</UserControl>
