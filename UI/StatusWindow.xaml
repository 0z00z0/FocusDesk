<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="FocusDesk.UI.StatusWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Window.SystemBackdrop>
        <MicaBackdrop Kind="BaseAlt" />
    </Window.SystemBackdrop>

    <!-- No scroller and no fixed height: the window is measured from this grid, so every line shows
         and a row that appears or disappears resizes the window rather than scrolling it. -->
    <Grid x:Name="RootGrid" Padding="16,12,16,16" KeyboardAcceleratorPlacementMode="Hidden">
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="Escape" Invoked="OnEscapeInvoked"/>
        </Grid.KeyboardAccelerators>

        <Grid.Resources>
            <!-- A section of the pop-out: a rounded card a shade lighter than the backdrop. -->
            <Style x:Key="CardStyle" TargetType="Border">
                <Setter Property="CornerRadius" Value="6"/>
                <Setter Property="Padding" Value="10,6"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}"/>
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}"/>
            </Style>

            <!-- A card's name, at the top-left of the card. -->
            <Style x:Key="CardHeadingStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource BrandFontFamily}"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="CharacterSpacing" Value="40"/>
                <Setter Property="Foreground" Value="{ThemeResource BrandAmberBrush}"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            </Style>

            <!-- One shape for every session-card control; local values, since the kind buttons swap style. -->
            <x:Double x:Key="SessionControlHeight">32</x:Double>
            <x:Double x:Key="SessionControlFontSize">12</x:Double>
            <Thickness x:Key="SessionControlPadding">10,5,10,6</Thickness>
            <Thickness x:Key="SessionControlBorder">1</Thickness>
            <CornerRadius x:Key="SessionControlCornerRadius">4</CornerRadius>
            <x:Double x:Key="SessionControlGap">6</x:Double>
        </Grid.Resources>

        <!-- Top-aligned, so its height is the content's own and a change in it raises SizeChanged. -->
        <StackPanel x:Name="ContentPanel" Spacing="8" VerticalAlignment="Top">

            <!-- The header: the mark, the product, and the way to the Settings window. -->
            <Grid ColumnSpacing="8" Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Image Grid.Column="0" Width="18" Height="18" VerticalAlignment="Center"
                       Source="ms-appx:///Assets/mark.svg"
                       AutomationProperties.AccessibilityView="Raw"/>
                <TextBlock Grid.Column="1" Text="FocusDesk" VerticalAlignment="Center"
                           FontSize="13" FontWeight="SemiBold"
                           Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                <Button Grid.Column="2" x:Name="SettingsButton"
                        Width="28" Height="28" Padding="0"
                        Style="{StaticResource QuickButtonStyle}"
                        Click="OnSettings">
                    <FontIcon Glyph="&#xE713;" FontSize="14"/>
                </Button>
            </Grid>

            <!-- The session. Only Cancel, inside the grace period, ends a session here — that is the
                 feature's central property, not an omission. -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="{StaticResource SessionControlGap}">
                    <!-- Four units above the first row, as under the other cards' headings. -->
                    <TextBlock x:Name="SessionHeading" Style="{StaticResource CardHeadingStyle}"
                               Margin="0,0,0,-2"/>

                    <Grid x:Name="StartRow" ColumnSpacing="{StaticResource SessionControlGap}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <ComboBox Grid.Column="0" x:Name="MinutesCombo"
                                  HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                  MinHeight="{StaticResource SessionControlHeight}"
                                  FontSize="{StaticResource SessionControlFontSize}"
                                  Padding="{StaticResource SessionControlPadding}"
                                  BorderThickness="{StaticResource SessionControlBorder}"
                                  CornerRadius="{StaticResource SessionControlCornerRadius}"/>
                        <!-- The menu part holds the three Program focus modes, for this start only. -->
                        <SplitButton Grid.Column="1" x:Name="StartButton"
                                HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                MinHeight="{StaticResource SessionControlHeight}"
                                FontSize="{StaticResource SessionControlFontSize}"
                                Padding="{StaticResource SessionControlPadding}"
                                BorderThickness="{StaticResource SessionControlBorder}"
                                CornerRadius="{StaticResource SessionControlCornerRadius}"
                                Click="OnStart">
                            <SplitButton.Flyout>
                                <MenuFlyout x:Name="ModeMenu" Placement="Bottom"/>
                            </SplitButton.Flyout>
                        </SplitButton>
                        <!-- Takes the Start button's place for the grace period only, counting down. -->
                        <Button Grid.Column="1" x:Name="CancelButton" Visibility="Collapsed"
                                HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                MinHeight="{StaticResource SessionControlHeight}"
                                FontSize="{StaticResource SessionControlFontSize}"
                                Padding="{StaticResource SessionControlPadding}"
                                BorderThickness="{StaticResource SessionControlBorder}"
                                CornerRadius="{StaticResource SessionControlCornerRadius}"
                                Style="{StaticResource AccentButtonStyle}"
                                Click="OnCancel"/>
                    </Grid>

                    <!-- A Program focus session's mode, changeable for the grace period only. -->
                    <StackPanel x:Name="GraceModePanel" Spacing="2" Visibility="Collapsed">
                        <TextBlock x:Name="GraceModeHeading" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                        <StackPanel x:Name="GraceModeChoices"/>
                    </StackPanel>

                    <!-- Both kinds, every time. Pressing one only chooses it, and the chosen kind
                         carries the accent; the Start button above opens the focus-point window, and
                         the session starts from there. Each showing begins on the stored default, and
                         choosing here never changes it. The texts come from the resource files. -->
                    <Grid x:Name="KindChoices" ColumnSpacing="{StaticResource SessionControlGap}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <!-- A disabled button shows no hover text of its own, so the reason sits on a
                             transparent frame around it. -->
                        <Grid Grid.Column="0" x:Name="ProgramFocusFrame" Background="Transparent">
                            <Button x:Name="ProgramFocusChoice"
                                    HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                    MinHeight="{StaticResource SessionControlHeight}"
                                    FontSize="{StaticResource SessionControlFontSize}"
                                    Padding="{StaticResource SessionControlPadding}"
                                    BorderThickness="{StaticResource SessionControlBorder}"
                                    CornerRadius="{StaticResource SessionControlCornerRadius}"
                                    Click="OnChooseProgramFocus"/>
                        </Grid>
                        <Button Grid.Column="1" x:Name="ScreenBreakChoice"
                                HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                MinHeight="{StaticResource SessionControlHeight}"
                                FontSize="{StaticResource SessionControlFontSize}"
                                Padding="{StaticResource SessionControlPadding}"
                                BorderThickness="{StaticResource SessionControlBorder}"
                                CornerRadius="{StaticResource SessionControlCornerRadius}"
                                Style="{StaticResource AccentButtonStyle}"
                                Click="OnChooseScreenBreak"/>
                    </Grid>

                    <!-- Session buttons or the goal: both always laid out here, so a kind switch moves nothing below. -->
                    <Grid x:Name="SessionDetailCell">
                        <Grid x:Name="NamedSessionChoices"/>
                        <TextBox x:Name="GoalBox" AcceptsReturn="False"
                                 VerticalAlignment="Top"
                                 MinHeight="{StaticResource SessionControlHeight}"
                                 FontSize="{StaticResource SessionControlFontSize}"
                                 Padding="{StaticResource SessionControlPadding}"
                                 BorderThickness="{StaticResource SessionControlBorder}"
                                 CornerRadius="{StaticResource SessionControlCornerRadius}"/>
                    </Grid>

                    <Button x:Name="SaveOpenProgramsButton"
                            HorizontalAlignment="Stretch"
                            MinHeight="{StaticResource SessionControlHeight}"
                            FontSize="{StaticResource SessionControlFontSize}"
                            Padding="{StaticResource SessionControlPadding}"
                            BorderThickness="{StaticResource SessionControlBorder}"
                            CornerRadius="{StaticResource SessionControlCornerRadius}"
                            Click="OnSaveOpenPrograms"/>

                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Column="0" Width="84" Height="84">
                            <Path x:Name="RingTrack" StrokeThickness="7" StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round" Opacity="0.22"
                                  Stroke="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <Path x:Name="RingFill" StrokeThickness="7" StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"/>
                            <TextBlock x:Name="MinutesText" HorizontalAlignment="Center"
                                       VerticalAlignment="Center" FontSize="24"
                                       Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                        </Grid>

                        <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                            <TextBlock x:Name="StatusText"
                                       FontSize="13" TextWrapping="Wrap"
                                       Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                            <TextBlock x:Name="WayOutText"
                                       FontSize="11" TextWrapping="Wrap"
                                       Visibility="Collapsed"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                    </Grid>

                    <TextBlock x:Name="RefusalText"
                               FontSize="11" TextWrapping="Wrap"
                               Visibility="Collapsed"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </StackPanel>
            </Border>

            <!-- The restrictions in force, one short line each. Tinted while any is. -->
            <Border x:Name="LeverCard" Style="{StaticResource CardStyle}">
                <StackPanel Spacing="4">
                    <TextBlock x:Name="LeverHeading" Style="{StaticResource CardHeadingStyle}"/>
                    <TextBlock x:Name="LeverText" FontSize="12" TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                </StackPanel>
            </Border>

            <!-- The finished sessions, newest first. A reading, not a setting, which is why it lives
                 here rather than on the Focus settings page. -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="4">
                    <TextBlock x:Name="HistoryHeading" Style="{StaticResource CardHeadingStyle}"/>
                    <StackPanel x:Name="HistoryRows" Spacing="3"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</Window>
