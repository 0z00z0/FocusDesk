<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="FocusDesk.UI.StatusWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Window.SystemBackdrop>
        <MicaBackdrop Kind="BaseAlt" />
    </Window.SystemBackdrop>

    <!-- No scroller and no fixed height: the window is measured from this grid, so every line shows
         and a row that appears or disappears resizes the window rather than scrolling it. -->
    <Grid x:Name="RootGrid" Padding="16,12,16,16" KeyboardAcceleratorPlacementMode="Hidden">
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="Escape" Invoked="OnEscapeInvoked"/>
        </Grid.KeyboardAccelerators>

        <Grid.Resources>
            <!-- A section of the pop-out: a rounded card a shade lighter than the backdrop. -->
            <Style x:Key="CardStyle" TargetType="Border">
                <Setter Property="CornerRadius" Value="6"/>
                <Setter Property="Padding" Value="10,6"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}"/>
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}"/>
            </Style>

            <!-- A card's name, at the top-left of the card. -->
            <Style x:Key="CardHeadingStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource BrandFontFamily}"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="CharacterSpacing" Value="40"/>
                <Setter Property="Foreground" Value="{ThemeResource BrandAmberBrush}"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            </Style>
        </Grid.Resources>

        <!-- Top-aligned, so its height is the content's own and a change in it raises SizeChanged. -->
        <StackPanel x:Name="ContentPanel" Spacing="8" VerticalAlignment="Top">

            <!-- The header: the mark, the product, the way back to the focus point, and the way to
                 the Settings window. -->
            <Grid ColumnSpacing="8" Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Image Grid.Column="0" Width="18" Height="18" VerticalAlignment="Center"
                       Source="ms-appx:///Assets/mark.svg"
                       AutomationProperties.AccessibilityView="Raw"/>
                <TextBlock Grid.Column="1" Text="FocusDesk" VerticalAlignment="Center"
                           FontSize="13" FontWeight="SemiBold"
                           Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                <!-- Hidden while the focus point is showing: the button under the page leads back. -->
                <Button Grid.Column="2" x:Name="FocusPointButton"
                        Height="28" Padding="8,0"
                        Style="{StaticResource QuickButtonStyle}"
                        Click="OnShowFocusPoint">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE890;" FontSize="13"/>
                        <TextBlock x:Name="FocusPointButtonText" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Grid.Column="3" x:Name="SettingsButton"
                        Width="28" Height="28" Padding="0"
                        Style="{StaticResource QuickButtonStyle}"
                        ToolTipService.ToolTip="Settings"
                        AutomationProperties.Name="Settings"
                        Click="OnSettings">
                    <FontIcon Glyph="&#xE713;" FontSize="14"/>
                </Button>
            </Grid>

            <!-- The session-start focus point: a bundled page in an embedded browser, shown first in
                 each session and whenever the header's button asks for it. The height is fixed so the
                 window is measured from it like any other row; 400 keeps the page's 220-unit ring clear
                 of its top line and its bottom lines at this width. The way back sits outside the
                 page, because the page itself uses every click to restart its countdown. -->
            <StackPanel x:Name="FocusPointView" Spacing="8" Visibility="Collapsed">
                <Border Height="400" CornerRadius="6" Background="#FF0B0E11">
                    <Grid x:Name="FocusPointHost"/>
                </Border>
                <Button x:Name="SkipButton" HorizontalAlignment="Stretch" Click="OnSkipFocusPoint"/>
            </StackPanel>

            <!-- The countdown view: everything below is what the pop-out shows whenever the focus
                 point is not showing. -->
            <StackPanel x:Name="SessionView" Spacing="8">

                <!-- The session: the ring and the session's own lines, with the length on the heading
                     row and a start button per kind on a row of its own beneath. No control here ends
                     a session — that is the feature's central property, not an omission. -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="6">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Focus session"
                                       Style="{StaticResource CardHeadingStyle}"/>
                            <!-- Shown only where the Focus settings page has turned the start box on. -->
                            <ComboBox Grid.Column="1" x:Name="MinutesCombo" VerticalAlignment="Center"
                                      AutomationProperties.Name="Session length"/>
                        </Grid>

                        <!-- Both kinds, every time. The stored default carries the accent; starting either
                             here never changes it. The texts come from the resource files. -->
                        <Grid x:Name="StartBox" ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <!-- A disabled button shows no hover text of its own, so the reason sits on
                                 a transparent frame around it. -->
                            <Grid Grid.Column="0" x:Name="StartProgramFocusFrame" Background="Transparent">
                                <Button x:Name="StartProgramFocusButton" HorizontalAlignment="Stretch"
                                        Click="OnStartProgramFocus"/>
                            </Grid>
                            <Button Grid.Column="1" x:Name="StartScreenBreakButton"
                                    HorizontalAlignment="Stretch"
                                    Style="{StaticResource AccentButtonStyle}"
                                    Click="OnStartScreenBreak"/>
                        </Grid>

                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Grid Grid.Column="0" Width="84" Height="84">
                                <Path x:Name="RingTrack" StrokeThickness="7" StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round" Opacity="0.22"
                                      Stroke="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <Path x:Name="RingFill" StrokeThickness="7" StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"/>
                                <TextBlock x:Name="MinutesText" HorizontalAlignment="Center"
                                           VerticalAlignment="Center" FontSize="24"
                                           Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                            </Grid>

                            <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                                <TextBlock x:Name="StatusText"
                                           FontSize="13" TextWrapping="Wrap"
                                           Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                                <TextBlock x:Name="WayOutText"
                                           Text="Nothing on this computer ends a session. Home Assistant ends one early, after a five-minute wait and a second request."
                                           FontSize="11" TextWrapping="Wrap"
                                           Visibility="Collapsed"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock x:Name="RefusalText"
                                   FontSize="11" TextWrapping="Wrap"
                                   Visibility="Collapsed"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                </Border>

                <!-- What a session holds, as a reading. Tinted while a lever is in force. -->
                <Border x:Name="LeverCard" Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Screen" Style="{StaticResource CardHeadingStyle}"/>
                        <TextBlock x:Name="LeverText" FontSize="12" TextWrapping="Wrap"
                                   Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                    </StackPanel>
                </Border>

                <!-- The finished sessions, newest first. A reading, not a setting, which is why it lives
                     here rather than on the Focus settings page. -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Recent sessions" Style="{StaticResource CardHeadingStyle}"/>
                        <StackPanel x:Name="HistoryRows" Spacing="3"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
