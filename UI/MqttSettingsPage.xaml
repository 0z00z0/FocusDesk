<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="FocusDesk.UI.MqttSettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mqtt="using:ZeroZero.Mqtt.WinUI">

    <StackPanel Spacing="4">
        <TextBlock Text="MQTT" Style="{StaticResource SectionHeaderStyle}"/>

        <!-- Said once, above everything: it is why the page matters rather than what a control does. -->
        <TextBlock Text="Home Assistant is the only place a running focus session can be ended early. Switch publishing off and a session runs to its own clock."
                   TextWrapping="Wrap" Margin="0,0,0,12"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

        <!-- Shown instead of the panel when startup never built the publisher. A panel that was never
             initialised would offer controls committing into nothing. -->
        <TextBlock x:Name="Unavailable" Visibility="Collapsed" TextWrapping="Wrap"
                   Text="Publishing could not be started. The log says why."
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

        <!-- No scroll viewer of its own: the settings shell puts one over every page. -->
        <mqtt:MqttSettingsPanel x:Name="Panel"/>
    </StackPanel>
</UserControl>
