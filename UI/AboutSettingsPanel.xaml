<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="FocusDesk.UI.AboutSettingsPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:brand="using:ZeroZero.Brand.WinUI">

    <UserControl.Resources>
        <!-- A faint rounded frame for the About control's coloured header block alone, applied to
             that block from code-behind; everything under it stays unframed. -->
        <Style x:Key="AboutHeaderFrameStyle" TargetType="Border">
            <Setter Property="BorderBrush" Value="{ThemeResource ControlStrokeColorDefaultBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="{ThemeResource ControlCornerRadius}"/>
        </Style>
    </UserControl.Resources>

    <StackPanel Spacing="4" HorizontalAlignment="Left">
        <TextBlock Text="About" Style="{StaticResource SectionHeaderStyle}"/>

        <!-- Inline rather than behind a button opening a second window: the page is already the
             place someone went looking. -->
        <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="{ThemeResource ControlCornerRadius}"
                Padding="16">
            <brand:BrandAboutControl x:Name="About"/>
        </Border>

        <!-- Under the card rather than inside it: the version it compares against is the card's, but
             the check is an action and the card is a statement. -->
        <brand:BrandBracketButton x:Name="CheckForUpdatesButton"
                                  HorizontalAlignment="Center" Margin="0,12,0,0"/>
    </StackPanel>
</UserControl>
