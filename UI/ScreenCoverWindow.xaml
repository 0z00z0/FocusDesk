<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="FocusDesk.UI.ScreenCoverWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- No backdrop and no theme brush: the point of this window is that it is black, so the colour
         is a literal rather than anything that could resolve to a translucent or lighter value. -->
    <Grid Background="#FF000000">

        <!-- Empty in the ring visual. The focus-point visual puts its browser here, built only when
             that visual is chosen so no browser process starts for a cover that draws its own ring. -->
        <Grid x:Name="FocusPointHost" />

        <!-- The panel is sized in device-independent units and scaled as one, so it is the same
             physical size at 100 % and at 200 %. DownOnly: it shrinks to fit a short or narrow
             display and never grows to fill a wide one, which keeps it centred and proportional on
             a 3:2 panel and on a 16:9 one alike. The margin is what stops it touching the edge on
             the smallest screen it can land on. -->
        <Viewbox x:Name="Reveal"
                 Stretch="Uniform"
                 StretchDirection="DownOnly"
                 Margin="48"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Center"
                 Visibility="Collapsed">
            <StackPanel Width="460" Spacing="28" HorizontalAlignment="Center">

                <!-- The dial. Stroke widths and lengths are declared in the same units as the canvas,
                     so they scale with the panel instead of staying fixed pixels.

                     Four layers, outermost first: the radar sweep travelling round on its own clock;
                     sixty marks, spent and remaining drawn as two paths so each carries its own
                     colour; a hairline arc inside them reading the exact remainder; and the leading
                     mark, a dot that breathes on the same ten-second rhythm as the focus-point
                     visual's own dot, so the two visuals read as one family. -->
                <Grid Width="220" Height="220" HorizontalAlignment="Center">
                    <Canvas Width="220" Height="220">

                        <Path x:Name="SweepArc"
                              StrokeThickness="11"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              Canvas.Left="0" Canvas.Top="0">
                            <Path.Stroke>
                                <LinearGradientBrush StartPoint="0,1" EndPoint="1,0">
                                    <GradientStop Color="#00FFFFFF" Offset="0.0"/>
                                    <GradientStop Color="#12FFFFFF" Offset="0.6"/>
                                    <GradientStop Color="#54FFFFFF" Offset="1.0"/>
                                </LinearGradientBrush>
                            </Path.Stroke>
                            <Path.RenderTransform>
                                <RotateTransform x:Name="SweepRotate" CenterX="110" CenterY="110"/>
                            </Path.RenderTransform>
                        </Path>

                        <Path x:Name="TickSpent"
                              Stroke="#22FFFFFF"
                              StrokeThickness="3"
                              Canvas.Left="0" Canvas.Top="0"/>

                        <Path x:Name="TickLit"
                              StrokeThickness="3"
                              Canvas.Left="0" Canvas.Top="0"/>

                        <Path x:Name="RingFill"
                              StrokeThickness="2.5"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              Opacity="0.5"
                              Canvas.Left="0" Canvas.Top="0"/>

                        <Ellipse x:Name="LeadDot"
                                 Width="11" Height="11"
                                 RenderTransformOrigin="0.5,0.5"
                                 Canvas.Left="0" Canvas.Top="0">
                            <Ellipse.RenderTransform>
                                <ScaleTransform x:Name="LeadScale" ScaleX="1" ScaleY="1"/>
                            </Ellipse.RenderTransform>
                        </Ellipse>
                    </Canvas>

                    <StackPanel x:Name="Readout"
                                HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="-6">
                        <TextBlock x:Name="AmountText"
                                   Text="--"
                                   FontSize="62"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   Foreground="#FFFFFFFF"/>
                        <!-- Text set from code: the unit changes from minutes to seconds in the last
                             minute, and both come from the resource file. -->
                        <TextBlock x:Name="UnitText"
                                   FontSize="15"
                                   CharacterSpacing="120"
                                   HorizontalAlignment="Center"
                                   Foreground="#B4FFFFFF"/>
                    </StackPanel>
                </Grid>

                <!-- Pure white on pure black: the highest contrast the surface can carry, which is
                     what keeps this readable when the brightness lever has taken the panel to its
                     floor. Nothing here writes a brightness. -->
                <TextBlock Text="Focus session in progress"
                           FontSize="34"
                           FontWeight="Bold"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           HorizontalAlignment="Center"
                           Foreground="#FFFFFFFF"/>

                <TextBlock x:Name="LeversText"
                           FontSize="16"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           HorizontalAlignment="Center"
                           Foreground="#B4FFFFFF"/>

                <TextBlock Text="It ends by itself. Nothing on this computer can end it early."
                           FontSize="15"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           HorizontalAlignment="Center"
                           Foreground="#8CFFFFFF"/>
            </StackPanel>
        </Viewbox>
    </Grid>
</Window>
