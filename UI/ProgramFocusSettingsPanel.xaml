<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="FocusDesk.UI.ProgramFocusSettingsPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:zz="using:ZeroZero.Controls.WinUI">

    <!-- The Presets section of ChargeKeeper's Smart Charge page, holding named sessions. The texts
         come from the resource files. -->
    <StackPanel Spacing="4">
        <TextBlock x:Name="PageTitle" Style="{StaticResource SectionHeaderStyle}"/>

        <zz:SettingsSectionHeader x:Name="NamedSessionsHeader" ShowDivider="False"/>
        <TextBlock x:Name="NamedSessionsDescriptionText" TextWrapping="Wrap" FontSize="12"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,0,0,4"/>

        <StackPanel x:Name="NamedSessionsListPanel" Spacing="4"/>
        <Grid x:Name="AddNamedSessionFrame" Background="Transparent" HorizontalAlignment="Left" Margin="0,4,0,12">
            <StackPanel Spacing="4">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Name="AddNamedSessionButton" Click="OnAddNamedSession"/>
                    <Button x:Name="SaveOpenProgramsButton" Click="OnSaveOpenPrograms"/>
                </StackPanel>
                <TextBlock x:Name="SaveOpenNothingText" Visibility="Collapsed" TextWrapping="Wrap" FontSize="12"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            </StackPanel>
        </Grid>
    </StackPanel>
</UserControl>
