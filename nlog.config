<?xml version="1.0" encoding="utf-8"?>
<!--
  The app's forensic trail: one file, %AppData%\FocusDesk\Logs\app.log. Retention and size live
  HERE, not in code, so they can be changed on an installed machine without a rebuild.

  Loaded automatically by NLog from beside the exe (see Services/AppLog.cs). If this file is missing
  or unparseable, nothing is logged at all — the reasoning is in AppLog's remarks.
-->
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      internalLogLevel="Off">

  <targets>
    <!-- keepFileOpen="true" (NLog's default) silently drops a sibling process's concurrent writes.
         See docs/build-notes.md ("nlog.config") for the four traps this config avoids. -->
    <target name="appfile" xsi:type="RetryingWrapper" retryCount="5" retryDelayMilliseconds="20">
      <!-- Do not add concurrentWrites="true" (removed in NLog 6) or swap maxArchiveFiles for
           maxArchiveDays (age-based, deletes long-lived archives on the first write after an
           upgrade) — see docs/build-notes.md ("nlog.config"). -->
      <!-- ${date} carries no culture= on purpose: an empty culture reverts to the thread's culture
           and can stamp a non-Gregorian year. See docs/build-notes.md ("nlog.config"). -->
      <target name="appfile_file"
              xsi:type="File"
              fileName="${specialfolder:folder=ApplicationData}\FocusDesk\Logs\app.log"
              keepFileOpen="false"
              createDirs="true"
              encoding="utf-8"
              writeBom="false"
              archiveAboveSize="10485760"
              archiveEvery="Day"
              maxArchiveFiles="7"
              archiveSuffixFormat="_{1:yyyy-MM-dd}_{0:00}"
              lineEnding="LF"
              layout="[${date:format=yyyy-MM-dd HH\:mm\:ss.fff zzz}] ${level:uppercase=true:padding=-5} ${pad:padding=-24:inner=${event-properties:item=class:whenEmpty=-}} ${message}" />
    </target>
  </targets>

  <rules>
    <logger name="*" minlevel="Info" writeTo="appfile" />
  </rules>
</nlog>
