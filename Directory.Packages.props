<Project>

  <!-- Central package management, switched on by the family's pin file. Every package the family
       shares is pinned there and nowhere else: a version attribute on a PackageReference, a second
       declaration, an Update that moves a pin, or a VersionOverride each fail the build (ZZB006 /
       NU1013). FocusDesk's own packages are declared below the import. -->

  <Import Project="ZeroZero.Packages.props" Sdk="ZeroZero.Build" />

  <!-- The shared library, one pin per component. A component's package version is its own tag
       without the prefix, so the numbers move independently and a bump here is a deliberate
       adoption. Every direct reference has its pin here. What arrives transitively is never
       declared as a PackageReference — the MQTT discovery layer and client, the primitives and the
       dump registration — because declaring one resolves the same assembly twice.

       ZeroZero.Startup, ZeroZero.SettingsShell.WinUI and ZeroZero.Tray.WinUI are genuine direct
       references — the watchdog task, wired in App.xaml.cs, the settings window shell, and the
       notification-area icon's host — and each carries a PackageReference below. ZeroZero.Tray, the
       plain half of the tray component, arrives with the host and keeps its pin here because the
       host's own floor must not decide it. ZeroZero.Win32 and ZeroZero.Controls.WinUI are pinned here without
       one: both already arrive transitively (Win32 through Mqtt.WinUI, Brand.WinUI and
       SettingsShell.WinUI, Controls.WinUI through Mqtt.WinUI and SettingsShell.WinUI), FocusDesk
       has no direct caller of either yet, and the family's own pin file declares no version for
       either — so without CentralPackageTransitivePinningEnabled the whole graph would keep
       resolving whatever floor Mqtt.WinUI 0.7.3 happens to specify, never the newer releases
       pinned here. -->
  <PropertyGroup>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup Label="ZeroZero shared library">
    <PackageVersion Include="ZeroZero.Brand.WinUI" Version="0.11.0" />
    <PackageVersion Include="ZeroZero.Config.Sections" Version="0.8.0" />
    <PackageVersion Include="ZeroZero.Config.Watch" Version="0.8.0" />
    <PackageVersion Include="ZeroZero.Controls.WinUI" Version="0.8.0" />
    <PackageVersion Include="ZeroZero.Diagnostics" Version="0.7.0" />
    <PackageVersion Include="ZeroZero.Lifecycle" Version="0.7.1" />
    <PackageVersion Include="ZeroZero.Mqtt.WinUI" Version="0.7.3" />
    <PackageVersion Include="ZeroZero.SettingsShell.WinUI" Version="0.8.0" />
    <PackageVersion Include="ZeroZero.Startup" Version="0.8.1" />
    <PackageVersion Include="ZeroZero.Tray" Version="0.9.0" />
    <PackageVersion Include="ZeroZero.Tray.WinUI" Version="0.9.0" />
    <PackageVersion Include="ZeroZero.Update" Version="0.11.0" />
    <PackageVersion Include="ZeroZero.Update.WinUI" Version="0.11.0" />
    <PackageVersion Include="ZeroZero.Win32" Version="0.9.1" />
  </ItemGroup>

  <!-- FocusDesk's own logging, not part of the shared library. The MAJOR matters: NLog 6 removed
       FileTarget.concurrentWrites and silently ignores unknown attributes, so nlog.config's
       concurrency settings are version-specific — read AppLog's remarks before moving this. -->
  <ItemGroup>
    <PackageVersion Include="NLog" Version="6.2.1" />
  </ItemGroup>

  <!-- WMI, the interface the display brightness is read and written through. Part of the .NET
       platform's out-of-band packages, so the version tracks the runtime's own. -->
  <ItemGroup>
    <PackageVersion Include="System.Management" Version="10.0.12" />
  </ItemGroup>

</Project>
